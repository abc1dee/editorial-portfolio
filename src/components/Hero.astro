---
/* Hero.astro — Editorial-style landing hero section in clean light mode */
---

<section
  id="hero"
  class="relative pt-24 sm:pt-28 pb-10 sm:pb-14 px-4 sm:px-6 lg:px-8 border-b border-border overflow-hidden"
>
  <!-- Main 2-Column Hero Card -->
  <div
    class="reveal w-full bg-white border border-neutral-200 rounded-3xl p-5 sm:p-7 lg:p-8 shadow-[0_4px_24px_-4px_rgba(0,0,0,0.04)]"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      <!-- Left Column: Portrait Image in Full-Height Rounded Frame -->
      <div class="lg:col-span-5 flex flex-col">
        <div
          class="relative w-full h-[380px] sm:h-[460px] lg:h-full min-h-[380px] lg:min-h-[540px] rounded-2xl overflow-hidden border border-neutral-200/90 bg-neutral-100 shadow-2xs group"
        >
          <img
            src="/images/projects/main-photo.jpg"
            alt="Abcdee Glorioso — Profile Portrait"
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            onerror="this.style.display='none'"
          />

          <!-- Live Status Indicator Pill -->
          <div
            class="absolute bottom-3.5 left-3.5 right-3.5 flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white/90 backdrop-blur-md border border-neutral-200/80 shadow-xs"
          >
            <span class="inline-flex items-center gap-2 text-[11px] font-mono font-medium text-neutral-800 uppercase tracking-wider">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full bg-emerald-500 opacity-75 rounded-full"></span>
                <span class="relative inline-flex h-2 w-2 bg-emerald-600 rounded-full"></span>
              </span>
              Open for Offers
            </span>
            <span class="text-[10px] font-mono text-neutral-500 tracking-wider">FULL-STACK</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Text Hierarchy & Quick Link Menu Rows -->
      <div class="lg:col-span-7 flex flex-col justify-between py-1 lg:py-2">
        <!-- Header & Bio Text -->
        <div>
          <!-- Top Subtitle Eyebrow -->
          <div
            class="font-mono text-xs sm:text-[13px] tracking-widest uppercase text-neutral-600 font-semibold mb-2.5 sm:mb-3 flex items-center gap-2"
          >
            <span class="text-neutral-900">✦</span> FULL-STACK & SYSTEMS ENGINEER
          </div>

          <!-- Main Title -->
          <h1
            class="text-4xl sm:text-5xl lg:text-[54px] font-black tracking-tight text-[#111827] leading-[0.95] uppercase mb-3 sm:mb-4"
          >
            ABCDEE GLORIOSO
          </h1>

          <!-- Bio Text -->
          <p class="text-sm sm:text-base text-neutral-600 leading-relaxed font-normal mb-5 sm:mb-6 max-w-xl">
            I design and build high-performance systems — from interactive client applications to low-latency backends and distributed APIs.
          </p>
        </div>

        <!-- Quick Links / Action List (Matches Nav: Work, Practicum, About, Credentials, Contact) -->
        <div
          class="border-t border-neutral-200 divide-y divide-neutral-200 overflow-y-auto max-h-[310px] sm:max-h-[350px] lg:max-h-[380px] pr-1.5 scroll-smooth"
        >
          <!-- Row 1: Work -->
          <a
            href="#projects"
            class="group flex items-center justify-between py-2.5 sm:py-3 px-2 -mx-2 rounded-xl hover:bg-neutral-50 transition-all duration-200 focus-ring"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-neutral-400 group-hover:text-neutral-900 transition-colors">01</span>
              <div>
                <span class="text-sm sm:text-base font-semibold text-[#111827] group-hover:text-black transition-colors block">
                  Work
                </span>
                <span class="text-[11px] sm:text-xs text-neutral-500 font-normal hidden sm:block">
                  Featured production apps & systems architecture
                </span>
              </div>
            </div>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-700 shadow-2xs group-hover:bg-neutral-900 group-hover:border-neutral-900 group-hover:text-white transition-all duration-200"
            >
              <span>View</span>
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </span>
          </a>

          <!-- Row 2: Practicum -->
          <a
            href="/practicum"
            class="group flex items-center justify-between py-2.5 sm:py-3 px-2 -mx-2 rounded-xl hover:bg-neutral-50 transition-all duration-200 focus-ring"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-neutral-400 group-hover:text-neutral-900 transition-colors">02</span>
              <div>
                <span class="text-sm sm:text-base font-semibold text-[#111827] group-hover:text-black transition-colors block">
                  Practicum
                </span>
                <span class="text-[11px] sm:text-xs text-neutral-500 font-normal hidden sm:block">
                  Enterprise internship report, SSO modules & leave systems
                </span>
              </div>
            </div>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-700 shadow-2xs group-hover:bg-neutral-900 group-hover:border-neutral-900 group-hover:text-white transition-all duration-200"
            >
              <span>Explore</span>
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </span>
          </a>

          <!-- Row 3: About -->
          <a
            href="#about"
            class="group flex items-center justify-between py-2.5 sm:py-3 px-2 -mx-2 rounded-xl hover:bg-neutral-50 transition-all duration-200 focus-ring"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-neutral-400 group-hover:text-neutral-900 transition-colors">03</span>
              <div>
                <span class="text-sm sm:text-base font-semibold text-[#111827] group-hover:text-black transition-colors block">
                  About
                </span>
                <span class="text-[11px] sm:text-xs text-neutral-500 font-normal hidden sm:block">
                  Engineering background, technical stack & philosophy
                </span>
              </div>
            </div>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-700 shadow-2xs group-hover:bg-neutral-900 group-hover:border-neutral-900 group-hover:text-white transition-all duration-200"
            >
              <span>Read</span>
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </span>
          </a>

          <!-- Row 4: Credentials -->
          <a
            href="#certifications"
            class="group flex items-center justify-between py-2.5 sm:py-3 px-2 -mx-2 rounded-xl hover:bg-neutral-50 transition-all duration-200 focus-ring"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-neutral-400 group-hover:text-neutral-900 transition-colors">04</span>
              <div>
                <span class="text-sm sm:text-base font-semibold text-[#111827] group-hover:text-black transition-colors block">
                  Credentials
                </span>
                <span class="text-[11px] sm:text-xs text-neutral-500 font-normal hidden sm:block">
                  Verified Google Cloud networking, DevOps & ML certifications
                </span>
              </div>
            </div>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-700 shadow-2xs group-hover:bg-neutral-900 group-hover:border-neutral-900 group-hover:text-white transition-all duration-200"
            >
              <span>Verify</span>
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </span>
          </a>

          <!-- Row 5: Contact -->
          <a
            href="#contact"
            class="group flex items-center justify-between py-2.5 sm:py-3 px-2 -mx-2 rounded-xl hover:bg-neutral-50 transition-all duration-200 focus-ring"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-neutral-400 group-hover:text-neutral-900 transition-colors">05</span>
              <div>
                <span class="text-sm sm:text-base font-semibold text-[#111827] group-hover:text-black transition-colors block">
                  Contact
                </span>
                <span class="text-[11px] sm:text-xs text-neutral-500 font-normal hidden sm:block">
                  Direct email, discussions & opportunities
                </span>
              </div>
            </div>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-700 shadow-2xs group-hover:bg-neutral-900 group-hover:border-neutral-900 group-hover:text-white transition-all duration-200"
            >
              <span>Connect</span>
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
