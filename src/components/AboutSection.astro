---
/* AboutSection.astro — High-end editorial profile & technical background section */
const skillGroups = [
  {
    category: "Mobile & Frontend",
    skills: ["React Native", "Expo", "Vue 3", "Nuxt 3", "TypeScript", "Tailwind CSS"],
  },
  {
    category: "Backend & Systems",
    skills: ["Python", "FastAPI", "Node.js", "Laravel 12", "REST APIs", "OAuth2 / OIDC"],
  },
  {
    category: "Databases & Cloud",
    skills: ["PostgreSQL", "Supabase", "MySQL", "Google Cloud Platform", "Prisma"],
  },
];

const principles = [
  {
    num: "01",
    title: "Problem First",
    desc: "Understanding the domain, architecture, and edge cases before writing a line of code.",
  },
  {
    num: "02",
    title: "System Integrity",
    desc: "Strict type safety, database transactional integrity, and maintainable schemas.",
  },
  {
    num: "03",
    title: "Tactile Experience",
    desc: "Snappy, high-contrast, and intuitive interfaces with intentional user feedback.",
  },
];
---

<section id="about" class="border-b border-border p-6 sm:p-10 lg:p-12 bg-white">
  <!-- Section Header -->
  <div class="mb-8 sm:mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-neutral-200">
    <div>
      <div class="reveal font-mono text-[11px] text-neutral-500 tracking-widest mb-3 flex items-center gap-2">
        <span class="text-neutral-900 font-bold">03.</span> PROFILE // ABOUT THE ENGINEER
      </div>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111827]">
        The Engineer Behind The Work
      </h2>
    </div>
    <p class="reveal reveal-delay-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal max-w-sm">
      A look into my engineering philosophy, technical background, and problem-solving approach.
    </p>
  </div>

  <!-- Main Profile Card Container -->
  <div
    class="reveal reveal-delay-1 w-full bg-neutral-50/70 border border-neutral-200 rounded-2xl sm:rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Personal Context, Philosophy & Quick Links -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Nickname Origin Story Callout -->
        <div class="p-5 sm:p-6 rounded-2xl bg-white border border-neutral-200 shadow-2xs">
          <div class="flex items-center gap-2 mb-2.5 text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
            <span class="text-neutral-900">✦</span> ABOUT THE NICKNAME
          </div>
          <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed font-light">
            Most people call me <strong class="text-neutral-950 font-semibold font-sans">Deo</strong>. The moniker originated back in grade school when a teacher misread <strong class="text-neutral-950 font-semibold font-sans">"Abcdee"</strong> due to my notoriously poor handwriting — and it has proudly stuck with me ever since!
          </p>
        </div>

        <!-- Core Engineering Principles -->
        <div class="p-5 sm:p-6 rounded-2xl bg-white border border-neutral-200 shadow-2xs">
          <div class="flex items-center gap-2 mb-4 text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
            <span class="text-neutral-900">✦</span> CORE PRINCIPLES
          </div>
          <div class="space-y-4">
            {principles.map((item) => (
              <div class="flex items-start gap-3">
                <span class="text-[11px] font-mono text-neutral-400 font-bold mt-0.5">{item.num}.</span>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold uppercase tracking-tight text-neutral-900">
                    {item.title}
                  </h4>
                  <p class="text-xs text-neutral-600 leading-relaxed font-light mt-0.5">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Social Action Buttons -->
        <div class="flex flex-wrap gap-3">
          <a
            href="https://github.com/abc1dee"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider border border-neutral-200 bg-white text-neutral-800 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition-all duration-300 shadow-2xs focus-ring"
            id="about-github-link"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>GitHub ↗</span>
          </a>
          <a
            href="https://www.linkedin.com/in/clarence-abcdee-glorioso-82b6951a1"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider border border-neutral-200 bg-white text-neutral-800 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition-all duration-300 shadow-2xs focus-ring"
            id="about-linkedin-link"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            <span>LinkedIn ↗</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Biography Narrative & Categorized Tech Stack -->
      <div class="lg:col-span-7 flex flex-col gap-8">
        <!-- Biography Text -->
        <div class="space-y-4 text-neutral-700 text-sm sm:text-base leading-relaxed font-light">
          <p>
            Hi, I'm <strong class="text-neutral-900 font-semibold font-sans">Abcdee Glorioso</strong>. I am a full-stack and systems engineer dedicated to building high-performance applications — from intuitive mobile interfaces to scalable, resilient backends and distributed architectures.
          </p>
          <p>
            I care deeply about clean system design, database integrity, and premium user experiences. Whether developing real-time personal finance apps with predictive ML models or engineering 15-module enterprise HRIS suites with biometric webcam verifications, I approach every challenge by dissecting the underlying constraints first.
          </p>
          <p>
            When I'm not coding, you'll find me exploring time-series algorithms, experimenting with predictive models, and dissecting distributed system architectures. I am continuously seeking opportunities to build impactful software alongside ambitious engineering teams.
          </p>
        </div>

        <!-- Categorized Tech Stack Grids -->
        <div class="p-6 rounded-2xl bg-white border border-neutral-200 shadow-2xs space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-100">
            <span class="font-mono text-xs font-bold text-neutral-500 uppercase tracking-wider">
              [ // TECHNICAL_COMPETENCIES ]
            </span>
            <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-widest">
              UPDATED 2026
            </span>
          </div>

          <div class="space-y-4">
            {skillGroups.map((group) => (
              <div>
                <span class="block text-[11px] font-mono uppercase tracking-wider text-neutral-500 mb-2 font-medium">
                  {group.category}
                </span>
                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  {group.skills.map((skill) => (
                    <span class="px-2.5 py-1 text-xs font-mono rounded-md bg-neutral-100 border border-neutral-200 text-neutral-800 transition-colors hover:border-neutral-900 hover:text-black">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Bottom Quick Stats Strip -->
        <div class="grid grid-cols-3 gap-3 py-3 px-4 rounded-xl bg-white border border-neutral-200 font-mono text-center shadow-2xs">
          <div>
            <span class="block text-xs sm:text-sm font-bold text-neutral-900">Full-Stack</span>
            <span class="text-[10px] text-neutral-400 uppercase tracking-wider block">Specialization</span>
          </div>
          <div class="border-x border-neutral-100">
            <span class="block text-xs sm:text-sm font-bold text-neutral-900">480 Hours</span>
            <span class="text-[10px] text-neutral-400 uppercase tracking-wider block">Practicum Completed</span>
          </div>
          <div>
            <span class="block text-xs sm:text-sm font-bold text-neutral-900">Manila, PH</span>
            <span class="text-[10px] text-neutral-400 uppercase tracking-wider block">Base (GMT+8)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
