---
interface Props {
  title: string;
  description: string;
  tags: string[];
  impact?: string;
  role?: string;
  href: string;
  thumbnail?: string;
  index?: number;
  githubUrl?: string;
  featured?: boolean;
}

const {
  title,
  description,
  tags,
  impact,
  role,
  href,
  thumbnail,
  index = 0,
  githubUrl,
  featured = false,
} = Astro.props;

const delayClass = `reveal-delay-${Math.min(index + 1, 4)}`;
---

{
  featured ? (
    /* Featured Full-Width Card (Asymmetric 2-Column Layout) */
    <div
      class={`reveal ${delayClass} group relative bg-white border border-neutral-200 rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-9 shadow-xs hover:shadow-md transition-all duration-300 focus-ring overflow-hidden`}
    >
      <!-- Covering Link for Project Details -->
      <a href={href} class="absolute inset-0 z-10" aria-label={`View ${title} project`} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-center">
        <!-- Left Side: Large Screenshot in Modern Rounded Frame Container -->
        <div class="lg:col-span-7 flex flex-col">
          <div
            class="relative aspect-[16/10] sm:aspect-[16/9] lg:aspect-[16/10] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-gradient-to-b from-neutral-50 to-neutral-100/90 border border-neutral-200/90 shadow-md group-hover:shadow-lg transition-all duration-300 flex items-center justify-center p-3 sm:p-5"
          >
            {thumbnail ? (
              <img
                src={thumbnail}
                alt={`${title} project preview`}
                class="max-h-full max-w-full w-auto h-auto object-contain rounded-lg sm:rounded-xl shadow-xs transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-neutral-100 text-neutral-400 font-mono text-xs uppercase tracking-wider">
                Preview coming soon
              </div>
            )}
          </div>
        </div>

        <!-- Right Side: Project Details -->
        <div class="lg:col-span-5 flex flex-col justify-between h-full py-1">
          <div>
            <!-- Index / Label & GitHub Link -->
            <div class="flex items-center justify-between font-mono text-xs text-neutral-400 font-bold tracking-widest uppercase mb-3">
              <span>FEATURED PROJECT // {String(index + 1).padStart(2, "0")}</span>
              {githubUrl && (
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="relative z-20 inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-900 transition-colors focus-ring"
                  title="View Source Code on GitHub"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  <span>GITHUB ↗</span>
                </a>
              )}
            </div>

            <!-- Main Title -->
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-[#111827] mb-1.5">
              {title}
            </h3>

            <!-- Key Highlight directly under Main Title as an italicized / muted sub-caption -->
            {impact && (
              <p class="text-xs sm:text-sm font-mono text-neutral-500 italic tracking-wide mb-4">
                {impact}
              </p>
            )}

            <!-- Bio / Description -->
            <p class="text-sm sm:text-base text-neutral-600 leading-relaxed font-normal mb-6">
              {description}
            </p>

            <!-- Tech Stack Tags as clean minimal pills -->
            <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-6">
              {tags.map((tag) => (
                <span class="px-2.5 py-1 text-xs font-mono rounded-md bg-neutral-100 border border-neutral-200 text-neutral-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Polished CTA Button at bottom right -->
          <div class="flex items-center justify-between gap-4 pt-4 border-t border-neutral-100 mt-auto">
            <span class="text-xs font-mono text-neutral-400 uppercase tracking-wider truncate">
              {role || "Full-Stack Project"}
            </span>
            <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider border border-neutral-900 bg-transparent text-neutral-900 group-hover:bg-neutral-900 group-hover:text-white transition-all duration-300 shadow-2xs shrink-0 whitespace-nowrap">
              <span>View Project</span>
              <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  ) : (
    /* Subsequent Project Card (Balanced Grid layout) */
    <div
      class={`reveal ${delayClass} group relative flex flex-col justify-between bg-white border border-neutral-200 rounded-2xl sm:rounded-3xl p-5 sm:p-7 shadow-xs hover:shadow-md transition-all duration-300 focus-ring overflow-hidden`}
    >
      <!-- Covering Link for Project Details -->
      <a href={href} class="absolute inset-0 z-10" aria-label={`View ${title} project`} />

      <div>
        <!-- Screenshot in Modern Rounded Frame Container -->
        <div
          class="relative aspect-[16/10] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-gradient-to-b from-neutral-50 to-neutral-100/90 border border-neutral-200/90 shadow-md group-hover:shadow-lg transition-all duration-300 flex items-center justify-center p-2 sm:p-3 mb-6"
        >
          {thumbnail ? (
            <img
              src={thumbnail}
              alt={`${title} project preview`}
              class="max-h-full max-w-full w-auto h-auto object-contain rounded-lg sm:rounded-xl shadow-xs transition-transform duration-500 ease-out group-hover:scale-[1.02]"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-neutral-100 text-neutral-400 font-mono text-xs uppercase tracking-wider">
              Preview coming soon
            </div>
          )}
        </div>

        <!-- Index / Label & GitHub Link -->
        <div class="flex items-center justify-between font-mono text-xs text-neutral-400 font-bold tracking-widest uppercase mb-2">
          <span>PROJECT {String(index + 1).padStart(2, "0")}</span>
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-20 inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-900 transition-colors focus-ring"
              title="View Source Code on GitHub"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <span>GITHUB ↗</span>
            </a>
          )}
        </div>

        <!-- Main Title -->
        <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#111827] mb-1">
          {title}
        </h3>

        <!-- Key Highlight directly under Main Title as an italicized / muted sub-caption -->
        {impact && (
          <p class="text-xs font-mono text-neutral-500 italic tracking-wide mb-3">
            {impact}
          </p>
        )}

        <!-- Bio / Description -->
        <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal mb-5">
          {description}
        </p>

        <!-- Tech Stack Tags as clean minimal pills -->
        <div class="flex flex-wrap gap-1.5 mb-6">
          {tags.map((tag) => (
            <span class="px-2 py-0.5 text-[11px] font-mono rounded-md bg-neutral-100 border border-neutral-200 text-neutral-700">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Polished CTA Button at bottom right -->
      <div class="flex items-center justify-between gap-4 pt-4 border-t border-neutral-100 mt-auto">
        <span class="text-xs font-mono text-neutral-400 uppercase tracking-wider truncate">
          {role || "Full-Stack Project"}
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-mono font-semibold uppercase tracking-wider border border-neutral-900 bg-transparent text-neutral-900 group-hover:bg-neutral-900 group-hover:text-white transition-all duration-300 shadow-2xs shrink-0 whitespace-nowrap">
          <span>View Project</span>
          <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </span>
      </div>
    </div>
  )
}
