---
/* PracticumSection.astro — Practicum showcase section on the main page linking to /practicum */
const stats = [
  { label: "Hours Rendered", value: "480 hrs" },
  { label: "Core Modules", value: "15" },
  { label: "Completion Rate", value: "100%" },
];

const techPills = [
  "Laravel 12",
  "Vue 3",
  "Inertia.js",
  "OAuth2 SSO",
  "Google 2FA",
  "Tailwind v4",
  "MySQL",
];
---

<section id="practicum" class="border-b border-border p-6 sm:p-10 lg:p-12 bg-white">
  <!-- Section Header -->
  <div class="mb-8 sm:mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-neutral-200">
    <div>
      <div class="reveal font-mono text-[11px] text-neutral-500 tracking-widest mb-3 flex items-center gap-2">
        <span class="text-neutral-900 font-bold">02.</span> PRACTICUM // ENTERPRISE INTERNSHIP
      </div>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111827]">
        Practicum Experience
      </h2>
    </div>
    <p class="reveal reveal-delay-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal max-w-sm">
      A 480-hour software engineering practicum at PurpleBug Inc., building the BeeConnected HRIS enterprise suite.
    </p>
  </div>

  <!-- Interactive Teaser Showcase Card -->
  <div
    class="reveal reveal-delay-2 group relative block bg-neutral-50/70 hover:bg-neutral-50 border border-neutral-200 rounded-2xl sm:rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs hover:shadow-md transition-all duration-300 focus-ring overflow-hidden"
  >
    <!-- Full-Card Redirect Link -->
    <a href="/practicum" class="absolute inset-0 z-10" aria-label="View Full Practicum Narrative Report"></a>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Context, Narrative & Metrics -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-6">
        <div>
          <!-- Company & Badge Tag -->
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-medium border border-neutral-200 bg-white text-neutral-800 shadow-2xs">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full bg-emerald-500 opacity-75 rounded-full"></span>
                <span class="relative inline-flex h-2 w-2 bg-emerald-600 rounded-full"></span>
              </span>
              PURPLEBUG INC. // 480 HRS COMPLETED
            </span>
          </div>

          <!-- Title & Role -->
          <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#111827] mb-1.5 group-hover:text-black transition-colors">
            BeeConnected HRIS Suite
          </h3>
          <p class="text-xs sm:text-sm font-mono text-neutral-500 italic tracking-wide mb-4">
            Software Engineering Intern & Systems Developer
          </p>

          <!-- Narrative description -->
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal mb-6">
            Engineered 15 production-grade modules powering multi-factor authentication, biometric webcam attendance verification, OAuth2 Single Sign-On, and automated Philippine statutory payroll computations.
          </p>

          <!-- Key Metrics Grid -->
          <div class="grid grid-cols-3 gap-2 sm:gap-3 py-3 px-3 sm:px-4 rounded-xl bg-white border border-neutral-200/80 font-mono text-center mb-6 shadow-2xs">
            {stats.map((stat, i) => (
              <div class={i === 1 ? "border-x border-neutral-100" : ""}>
                <span class="block text-base sm:text-lg font-bold text-neutral-900">{stat.value}</span>
                <span class="text-[10px] text-neutral-400 uppercase tracking-wider block">{stat.label}</span>
              </div>
            ))}
          </div>

          <!-- Tech Stack Tags -->
          <div class="flex flex-wrap gap-1.5">
            {techPills.map((tech) => (
              <span class="px-2.5 py-1 text-xs font-mono rounded-md bg-white border border-neutral-200 text-neutral-700">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Card Footer Action -->
        <div class="pt-4 border-t border-neutral-200/80 flex items-center justify-between mt-auto">
          <span class="text-xs font-mono text-neutral-400 uppercase tracking-wider">
            Apr 27 – Jul 24, 2026
          </span>
          <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider border border-neutral-900 bg-transparent text-neutral-900 group-hover:bg-neutral-900 group-hover:text-white transition-all duration-300 shadow-2xs shrink-0 whitespace-nowrap">
            <span>Explore Full Report</span>
            <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </span>
        </div>
      </div>

      <!-- Right Column: Visual System Preview Window -->
      <div class="lg:col-span-7 flex flex-col">
        <div
          class="relative w-full rounded-xl sm:rounded-2xl overflow-hidden border border-neutral-200/90 bg-white shadow-md group-hover:shadow-lg transition-all duration-300"
        >
          <!-- Terminal / Browser Frame Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-neutral-100/80 border-b border-neutral-200 text-[11px] font-mono text-neutral-500">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-neutral-300 border border-neutral-300"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-neutral-300 border border-neutral-300"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-neutral-300 border border-neutral-300"></span>
            </div>
            <span class="text-[10px] uppercase font-bold tracking-wider text-neutral-600">
              BEE_CONNECTED_HRIS // LIVE_PORTAL
            </span>
            <span class="text-[10px] text-emerald-600 font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              ACTIVE
            </span>
          </div>

          <!-- Dashboard Preview Screenshot -->
          <div class="relative aspect-[16/10] overflow-hidden bg-neutral-50 p-2 sm:p-3 flex items-center justify-center">
            <img
              src="/images/projects/Employee Dashboard and Time Clock Widget.png"
              alt="BeeConnected HRIS Employee Dashboard Preview"
              class="w-full h-full object-cover object-top rounded-lg shadow-2xs transition-transform duration-500 ease-out group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>

          <!-- Feature Highlights Footer Bar -->
          <div class="grid grid-cols-3 divide-x divide-neutral-200 border-t border-neutral-200 bg-white font-mono text-[10px] text-neutral-500 text-center py-2.5">
            <span>Biometric Webcam</span>
            <span>OAuth2 SSO Provider</span>
            <span>Statutory Payroll</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

