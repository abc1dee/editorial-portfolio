---
/* ContactSection.astro — High-end editorial contact & communication section */
const email = "abcdee1glorioso@gmail.com";
const linkedIn = "https://www.linkedin.com/in/clarence-abcdee-glorioso-82b6951a1";
const gitHub = "https://github.com/abc1dee";
---

<section id="contact" class="border-b border-border p-6 sm:p-10 lg:p-12 bg-white">
  <!-- Section Header -->
  <div class="mb-8 sm:mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-neutral-200">
    <div>
      <div class="reveal font-mono text-[11px] text-neutral-500 tracking-widest mb-3 flex items-center gap-2">
        <span class="text-neutral-900 font-bold">05.</span> CONNECT // GET IN TOUCH
      </div>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111827]">
        Let's Work Together
      </h2>
    </div>
    <p class="reveal reveal-delay-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal max-w-sm">
      Have a project in mind, an engineering opportunity, or just want to connect? Reach out anytime.
    </p>
  </div>

  <!-- Main Contact Card Container -->
  <div
    class="reveal reveal-delay-1 w-full bg-neutral-50/70 border border-neutral-200 rounded-2xl sm:rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Context, Availability & Location -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Live Availability Pill -->
        <div class="w-fit">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-800 shadow-2xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-emerald-500 opacity-75 rounded-full"></span>
              <span class="relative inline-flex h-2 w-2 bg-emerald-600 rounded-full"></span>
            </span>
            AVAILABLE FOR FULL-TIME ROLES
          </span>
        </div>

        <!-- Headline Statement -->
        <div>
          <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#111827] leading-tight mb-3">
            Open for engineering opportunities and collaboration.
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-light">
            I am currently considering full-time software engineering roles, distributed systems challenges, and high-impact product builds. Based in Manila (GMT+8) with full flexibility for remote workflows and global teams.
          </p>
        </div>

        <!-- Location & Response Stats Box -->
        <div class="grid grid-cols-2 gap-3 p-4 rounded-2xl bg-white border border-neutral-200 font-mono text-xs shadow-2xs">
          <div>
            <span class="text-[10px] text-neutral-400 uppercase tracking-wider block">Base Location</span>
            <span class="font-bold text-neutral-900 block mt-0.5">Manila, PH</span>
            <span class="text-[10px] text-neutral-500">GMT+8 (Remote Ready)</span>
          </div>
          <div>
            <span class="text-[10px] text-neutral-400 uppercase tracking-wider block">Response Time</span>
            <span class="font-bold text-neutral-900 block mt-0.5">&lt; 24 Hours</span>
            <span class="text-[10px] text-emerald-600 font-semibold">Fast Response</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Direct Contact Cards -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <!-- Email Communication Card -->
        <div
          class="group relative flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 p-5 sm:p-6 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-900 transition-all duration-300 shadow-2xs"
        >
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-neutral-100 border border-neutral-200 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4 text-neutral-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider block">DIRECT EMAIL</span>
              <span class="text-sm sm:text-base font-bold text-neutral-900 font-mono break-all">{email}</span>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button
              id="copy-email-btn"
              data-email={email}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-neutral-50 text-neutral-700 hover:bg-neutral-100 transition-colors cursor-pointer focus-ring"
              aria-label="Copy email address"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
              </svg>
              <svg id="check-icon" class="w-3.5 h-3.5 text-emerald-600 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span id="copy-label">Copy</span>
            </button>

            <a
              href={`mailto:${email}`}
              id="contact-email-link"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-mono font-semibold uppercase tracking-wider border border-neutral-900 bg-neutral-900 text-white hover:bg-black transition-all shadow-2xs focus-ring"
            >
              <span>Send Mail</span>
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </a>
          </div>
        </div>

        <!-- LinkedIn Professional Card -->
        <a
          href={linkedIn}
          target="_blank"
          rel="noopener noreferrer"
          id="contact-linkedin-link"
          class="group flex items-center justify-between p-5 sm:p-6 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-900 transition-all duration-300 shadow-2xs focus-ring"
        >
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-neutral-100 border border-neutral-200 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4 text-neutral-800" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </div>
            <div>
              <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider block">PROFESSIONAL PROFILE</span>
              <span class="text-sm sm:text-base font-bold text-neutral-900">Connect on LinkedIn</span>
            </div>
          </div>

          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-800 group-hover:border-neutral-900 group-hover:bg-neutral-900 group-hover:text-white transition-all shadow-2xs">
            <span>Connect</span>
            <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </span>
        </a>

        <!-- GitHub Source Code Card -->
        <a
          href={gitHub}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between p-5 sm:p-6 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-900 transition-all duration-300 shadow-2xs focus-ring"
        >
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-neutral-100 border border-neutral-200 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4 text-neutral-800" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </div>
            <div>
              <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider block">SOURCE CODE & REPOSITORIES</span>
              <span class="text-sm sm:text-base font-bold text-neutral-900">Explore on GitHub</span>
            </div>
          </div>

          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-mono font-medium border border-neutral-200 bg-white text-neutral-800 group-hover:border-neutral-900 group-hover:bg-neutral-900 group-hover:text-white transition-all shadow-2xs">
            <span>View Code</span>
            <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");
  const label = document.getElementById("copy-label");

  if (btn) {
    btn.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") || "";
      await navigator.clipboard.writeText(email);
      if (copyIcon && checkIcon && label) {
        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");
        label.textContent = "Copied!";
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          checkIcon.classList.add("hidden");
          label.textContent = "Copy";
        }, 2000);
      }
    });
  }
</script>
